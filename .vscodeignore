.vscode/**
.vscode-test/**
src/**
scripts/**
.gitignore
.gitattributes
.yarnrc
.yarnrc.yml
.npmrc
esbuild.config.mjs
vsc-extension-quickstart.md
**/tsconfig.json
**/tsconfig.*.json
**/.eslintrc.json
**/.eslintrc.*.json
**/tsconfig.tsbuildinfo
**/*.tsbuildinfo

# Source-Maps: nicht im Distribution-Pack
**/*.map

# TypeScript-Declaration-Files: zur Laufzeit nicht benötigt
**/*.d.ts
**/*.d.ts.map

# Repo-interne Hilfsmittel (nicht für End-User)
.serena/**
.github/**
docs/**
CLAUDE.md
CONTEXT.md
test-results/
coverage/

# Kompilierte Unit-Tests und tsc-Zwischendateien: der Production-Packaging-
# Schritt ersetzt out/extension.js durch das esbuild-Bundle. Die uebrigen
# out/{clients,commands,core,types,ui,utils}/-Dateien sind tsc-Output, der
# nur fuer die lokale Test-Ausfuehrung (mocha) gebraucht wird.
out/test/**
out/clients/**
out/commands/**
out/core/**
out/types/**
out/ui/**
out/utils/**
out/extension.js.map

# Build-Output und Per-Package-Metadata in node_modules
# (Hinweis: vsce wertet Re-Includes "!" als "komplettes Verzeichnis
# einbeziehen" und ignoriert .vscodeignore-Regeln im Inneren. Wir
# muessen daher JEDE Runtime-Datei explizit whitelisten statt ein
# Verzeichnis-Pattern zu nutzen.)
node_modules/**

# --- ssh2 (native C++-Bindings via cpu-features) ---
!node_modules/ssh2/package.json
!node_modules/ssh2/lib/index.js
!node_modules/ssh2/lib/client.js
!node_modules/ssh2/lib/server.js
!node_modules/ssh2/lib/agent.js
!node_modules/ssh2/lib/http-agents.js
!node_modules/ssh2/lib/keygen.js
!node_modules/ssh2/lib/utils.js
!node_modules/ssh2/lib/Channel.js
!node_modules/ssh2/lib/protocol/Protocol.js
!node_modules/ssh2/lib/protocol/handlers.js
!node_modules/ssh2/lib/protocol/handlers.misc.js
!node_modules/ssh2/lib/protocol/kex.js
!node_modules/ssh2/lib/protocol/keyParser.js
!node_modules/ssh2/lib/protocol/SFTP.js
!node_modules/ssh2/lib/protocol/constants.js
!node_modules/ssh2/lib/protocol/utils.js
!node_modules/ssh2/lib/protocol/zlib.js
!node_modules/ssh2/lib/protocol/node-fs-compat.js
!node_modules/ssh2/lib/protocol/crypto.js
!node_modules/ssh2/lib/protocol/crypto/poly1305.js

# --- cpu-features (vorkompilierte .node-Binary) ---
!node_modules/cpu-features/package.json
!node_modules/cpu-features/lib/index.js

# --- ssh2 transitive deps (pure-JS, required at module load) ---
# ssh2/lib/protocol/keyParser.js:20-21 requires `asn1` und `bcrypt-pbkdf`
# beim Modul-Load. Da ssh2 extern ist (native cpu-features), kann esbuild
# diese transitiven JS-Deps nicht selbst buendeln — sie muessen als
# Runtime-Files mitgeliefert werden. Ohne diese Eintraege scheitert die
# Extension-Aktivierung mit "Cannot find module 'asn1'" o.ae.

# asn1 (ssh2 -> asn1@^0.2.6)
!node_modules/asn1/package.json
!node_modules/asn1/lib/index.js
!node_modules/asn1/lib/ber/errors.js
!node_modules/asn1/lib/ber/index.js
!node_modules/asn1/lib/ber/reader.js
!node_modules/asn1/lib/ber/types.js
!node_modules/asn1/lib/ber/writer.js

# bcrypt-pbkdf (ssh2 -> bcrypt-pbkdf@^1.0.2)
!node_modules/bcrypt-pbkdf/package.json
!node_modules/bcrypt-pbkdf/index.js

# safer-buffer (asn1 -> safer-buffer@~2.1.0)
!node_modules/safer-buffer/package.json
!node_modules/safer-buffer/safer.js
!node_modules/safer-buffer/dangerous.js

# tweetnacl (bcrypt-pbkdf -> tweetnacl@^0.14.3)
!node_modules/tweetnacl/package.json
!node_modules/tweetnacl/nacl-fast.js